@host = http://localhost:8080

### Zelo 전체 흐름 시나리오 (프론트 없이)
# IntelliJ에서 위에서부터 순서대로 ▶ 실행 (또는 파일 맨 위 ▶▶ "Run All")
# 앱은 ZELO_SEED_ENABLED=true 로 시드 넣고 실행. 결제는 PORTONE_MODE 기본값(fake)이라 돈 안 나감
# LLM은 real 모드(실제 OPENAI_API_KEY)로 실행. fake 모드는 기본이 일반 질문 답변이라 견적 카드가 안 나옴

### 0. 준비: 이번 실행에서 쓸 이메일 만들기 (카테고리 조회로 서버 살아있는지도 확인)
GET {{host}}/api/categories

> {%
    client.test("서버 응답", () => client.assert(response.status === 200, "서버가 안 떠 있어요"));
    client.global.set("email", "zelo" + Date.now() + "@test.com");
    client.global.set("password", "Zelo1234!");
%}

### 1. 회원가입 (가입할 때 기본 배송지도 같이 만들어짐)
POST {{host}}/api/users
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "passwordConfirm": "{{password}}",
  "name": "시나리오테스트",
  "phoneNumber": "010-1234-5678",
  "place": "집",
  "addresses": "서울시 강남구 테헤란로 1",
  "zipCode": "06234"
}

> {%
    client.test("가입 201", () => client.assert(response.status === 201, "status " + response.status));
%}

### 2. 로그인 (토큰 저장)
POST {{host}}/api/users/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("로그인 200", () => client.assert(response.status === 200, "status " + response.status));
    client.global.set("token", response.body.data.accessToken);
%}

### 3. 기본 배송지 확인
GET {{host}}/api/users/me/addresses
Authorization: Bearer {{token}}

> {%
    client.test("배송지 1개 이상", () => client.assert(response.body.data.length >= 1, "배송지가 없어요"));
%}

### 4. 상품 검색 (판매량순, 재고 있는 것만)
GET {{host}}/api/products?keyword=김치&inStock=true&sort=SALES
Authorization: Bearer {{token}}

> {%
    client.test("김치 상품 검색됨", () => client.assert(response.body.data.content.length > 0, "검색 결과가 없어요. 시드를 넣었는지 확인"));
%}


### ===== 시나리오 A. 메뉴 추천에서 결제까지 =====

### A-1. 채팅 시작: 견적 카드 받기 (roomId, quoteId 저장)
POST {{host}}/api/chat/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "토요일 저녁에 초등학생 둘이랑 넷이 먹을 김치볶음밥 재료 3만 원 안에서 준비해 줘"
}

> {%
    const data = response.body.data;
    client.global.set("roomId", data.roomId);
    const card = data.message.payload;
    client.test("견적 카드가 옴", () => client.assert(card && card.type === "QUOTE_CARD", "견적 카드가 없어요: " + data.message.content));
    client.test("담긴 상품이 있음", () => client.assert(card.items.length > 0, "담긴 상품이 없어요"));
    client.global.set("firstQuoteId", card.quoteId);
    // LLM이 고른 재료가 매번 달라서, 견적에 실제로 담긴 첫 상품을 빼 달라고 한다
    client.global.set("removeName", card.items[0].productName);
%}

### A-2. 견적 수정: 새 견적 카드 (quoteId가 바뀌어야 함)
POST {{host}}/api/chat/rooms/{{roomId}}/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "집에 {{removeName}} 있어. 빼 줘"
}

> {%
    const card = response.body.data.payload;
    client.test("수정된 견적 카드가 옴", () => client.assert(card && card.type === "QUOTE_CARD", "견적 카드가 없어요: " + response.body.data.content));
    if (card) {
        client.test("quoteId가 새로 발급됨", () => client.assert(card.quoteId !== client.global.get("firstQuoteId"), "quoteId가 그대로예요"));
        client.global.set("quoteId", card.quoteId);
    }
%}

### A-3. 구매 확인 정보 발급 (예 버튼)
POST {{host}}/api/orders/confirmations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "quoteId": "{{quoteId}}"
}

> {%
    client.test("구매 확인 201", () => client.assert(response.status === 201, "status " + response.status + " " + JSON.stringify(response.body)));
    client.global.set("confirmationId", response.body.data.confirmationId);
%}

### A-4. 주문 생성 (orderId, portoneId 저장)
POST {{host}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quoteId": "{{quoteId}}",
  "confirmationId": "{{confirmationId}}"
}

> {%
    client.test("주문 201", () => client.assert(response.status === 201, "status " + response.status + " " + JSON.stringify(response.body)));
    client.test("결제 대기 상태", () => client.assert(response.body.data.status === "PAYMENT_PENDING", response.body.data.status));
    client.global.set("orderId", response.body.data.orderId);
    client.global.set("portoneId", response.body.data.portoneId);
%}

### A-5. 결제 확인 (fake 포트원은 바로 결제 완료로 응답)
POST {{host}}/api/payments/{{portoneId}}/confirm
Authorization: Bearer {{token}}

> {%
    client.test("결제 완료", () => client.assert(response.body.data.status === "PAID", JSON.stringify(response.body)));
%}

### A-6. 내 주문 목록에서 PAID 확인
GET {{host}}/api/orders
Authorization: Bearer {{token}}

> {%
    const order = response.body.data.content.find(o => o.orderId === client.global.get("orderId"));
    client.test("주문이 목록에 있음", () => client.assert(order, "목록에 주문이 없어요"));
    client.test("주문 상태 PAID", () => client.assert(order.status === "PAID", order && order.status));
%}


### ===== 시나리오 C. 사고 방지 =====

### C-1. 같은 주문 요청을 다시 보내도 주문은 1건 (새로 만들지 않고 기존 주문을 돌려줌)
POST {{host}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quoteId": "{{quoteId}}",
  "confirmationId": "{{confirmationId}}"
}

> {%
    client.test("새 주문 안 생김", () => client.assert(response.status !== 201, "status " + response.status + "로 새 주문이 생겼어요"));
    client.test("같은 주문", () => client.assert(response.status !== 200 || response.body.data.orderId === client.global.get("orderId"), "다른 주문이 왔어요"));
%}

### C-2. 수정 전 견적(첫 번째 quoteId)으로 구매 확인 → QUOTE_NOT_CURRENT
POST {{host}}/api/orders/confirmations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "quoteId": "{{firstQuoteId}}"
}

> {%
    client.test("수정 전 견적 거부", () => client.assert(response.body.code === "QUOTE_002", JSON.stringify(response.body)));
%}

### C-3. 남의 채팅방(없는 방)으로 구매 확인 → 거부
POST {{host}}/api/orders/confirmations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": 999999999,
  "quoteId": "{{quoteId}}"
}

> {%
    client.test("거부됨", () => client.assert(response.status >= 400, "status " + response.status));
%}


### ===== 시나리오 D. 제한 품목 (주류) =====

### D-1. 맥주를 같이 요청하면 견적에서 빠짐
POST {{host}}/api/chat/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "일요일에 넷이서 삼겹살 구워 먹을 건데 맥주 6캔도 같이 담아 줘"
}

> {%
    const card = response.body.data.message.payload;
    client.test("견적 카드가 옴", () => client.assert(card && card.type === "QUOTE_CARD", response.body.data.message.content));
    const blocked = card.excludedItems.find(i => i.reason === "CATEGORY_NOT_ALLOWED");
    client.test("주류가 빠짐", () => client.assert(blocked, JSON.stringify(card.excludedItems)));
%}


### ===== 시나리오 E. 결제 전 주문 취소 =====

### E-1. 새 견적 받기
POST {{host}}/api/chat/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "오늘 저녁 둘이서 김치볶음밥 해 먹을 재료 준비해 줘"
}

> {%
    client.global.set("cancelRoomId", response.body.data.roomId);
    client.global.set("cancelQuoteId", response.body.data.message.payload.quoteId);
%}

### E-2. 구매 확인
POST {{host}}/api/orders/confirmations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{cancelRoomId}},
  "quoteId": "{{cancelQuoteId}}"
}

> {%
    client.global.set("cancelConfirmationId", response.body.data.confirmationId);
%}

### E-3. 주문 생성 (결제는 안 함)
POST {{host}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quoteId": "{{cancelQuoteId}}",
  "confirmationId": "{{cancelConfirmationId}}"
}

> {%
    client.global.set("cancelOrderId", response.body.data.orderId);
%}

### E-4. 결제 전 취소 → CANCELED (선점 재고도 풀림)
POST {{host}}/api/orders/{{cancelOrderId}}/cancellations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "메뉴를 바꿨어요"
}

> {%
    client.test("취소됨", () => client.assert(response.body.data.orderStatus === "CANCELED", JSON.stringify(response.body)));
%}

### E-5. 이미 결제된 주문(A의 주문)은 결제 전 취소가 안 됨
POST {{host}}/api/orders/{{orderId}}/cancellations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "결제 후 취소 시도"
}

> {%
    client.test("결제된 주문은 거부", () => client.assert(response.status >= 400, "status " + response.status));
%}
